<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DivaModManager.Avalonia.Dialogs.TextInputDialog"
        Title="Input"
        Width="350" Height="150"
        Background="#202020"
        Foreground="#f2f2f2"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        CanResize="False">
  <Grid RowDefinitions="Auto,*,Auto" Margin="15">
    <TextBlock Name="PromptTextBlock" FontSize="14" FontFamily="{StaticResource AnekLatin}" Margin="0,0,0,10" TextWrapping="Wrap" />
    
    <TextBox Name="InputTextBox" Grid.Row="1" 
             Height="40" 
             FontSize="14" 
             FontFamily="{StaticResource AnekLatin}"
             Background="#1a1a1a" 
             BorderBrush="#424242" 
             Foreground="#f2f2f2"
             Padding="10" />
    
    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,15,0,0">
      <Button Name="OKButton" Content="OK" Width="100" Height="35" Background="#181818" BorderBrush="#252525" Foreground="#f2f2f2" FontFamily="{StaticResource AnekLatin}" />
      <Button Name="CancelButton" Content="Cancel" Width="100" Height="35" Background="#181818" BorderBrush="#252525" Foreground="#f2f2f2" FontFamily="{StaticResource AnekLatin}" />
    </StackPanel>
  </Grid>
</Window>

